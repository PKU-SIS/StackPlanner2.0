{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bid audit input manifest 1.0",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "documents"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "scope_note": {
      "type": "string",
      "minLength": 1
    },
    "data_root": {
      "type": "string",
      "default": "."
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "tender",
              "public_template",
              "bid",
              "quote_detail",
              "quote_opening"
            ]
          },
          "bidder": {
            "type": "string",
            "minLength": 1
          },
          "round": {
            "type": "string",
            "default": "1"
          },
          "lot": {
            "type": "string",
            "default": "1"
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "expected_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "enum": [
                    "bid",
                    "quote_detail",
                    "quote_opening"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "bidder"
              ]
            }
          }
        ]
      }
    },
    "parameters": {
      "type": "object",
      "properties": {
        "template_min_exact_chars": {
          "type": "integer",
          "minimum": 12,
          "maximum": 100,
          "default": 24
        },
        "min_residual_chars": {
          "type": "integer",
          "minimum": 12,
          "maximum": 1200,
          "default": 24
        },
        "response_similarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.85
        },
        "image_pair_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000000,
          "default": 500000
        },
        "image_dhash_distance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16,
          "default": 3
        }
      },
      "additionalProperties": false
    },
    "response_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement",
          "response",
          "source",
          "requirement_source"
        ],
        "properties": {
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "response": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "required": [
              "document_id",
              "page",
              "quote"
            ],
            "properties": {
              "document_id": {
                "type": "string",
                "minLength": 1
              },
              "page": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "requirement_source": {
            "type": "object",
            "required": [
              "document_id",
              "page",
              "quote"
            ],
            "properties": {
              "document_id": {
                "type": "string",
                "minLength": 1
              },
              "page": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "declared_deviation": {
            "type": "string"
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "value",
          "source"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "required": [
              "document_id",
              "page",
              "quote"
            ],
            "properties": {
              "document_id": {
                "type": "string",
                "minLength": 1
              },
              "page": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "error_terms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 80
      }
    }
  }
}